# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT credentials. Nothing here is shared with staging
# or production, which get their secrets from Fly/Vercel secret stores instead.
# Generate the passwords rather than typing something memorable:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# Postgres
#
# Three roles, three connection strings (ADR-0003):
#   ai_migrator  owns the tables, runs DDL only, direct (unpooled) connection
#   ai_app       serves requests; no ownership, no BYPASSRLS, tenant-scoped
#   ai_worker    drains the queue; cross-tenant on `job` only
#
# Locally the Compose superuser plays ai_migrator. The two runtime roles are
# created by migration 0001 with NOLOGIN and given passwords by
# `uv run bootstrap-db-roles`, so no credential is ever written into a
# migration file.
# ---------------------------------------------------------------------------
POSTGRES_USER=ai_interviewer
POSTGRES_PASSWORD=            # generate one
POSTGRES_DB=ai_interviewer
POSTGRES_PORT=5432

MIGRATION_DATABASE_URL=postgresql+psycopg://ai_interviewer:CHANGE_ME@localhost:5432/ai_interviewer
DATABASE_URL=postgresql+psycopg://ai_app:CHANGE_ME_APP@localhost:5432/ai_interviewer
WORKER_DATABASE_URL=postgresql+psycopg://ai_worker:CHANGE_ME_WORKER@localhost:5432/ai_interviewer

# Consumed only by `bootstrap-db-roles`, which sets these on the roles.
DB_APP_PASSWORD=              # generate one
DB_WORKER_PASSWORD=           # generate one

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, Tigris/R2 in deployment)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=          # generate one; min 8 chars or MinIO refuses to start
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ai-interviewer-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=         # same value as MINIO_ROOT_PASSWORD locally
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Anthropic — not needed until Phase 3. Phases 0-2 run fully offline.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
API_PORT=8000
ENVIRONMENT=local
LOG_LEVEL=INFO

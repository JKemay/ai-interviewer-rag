# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT credentials. Nothing here is shared with staging
# or production, which get their secrets from Fly/Vercel secret stores instead.
# Generate the passwords rather than typing something memorable:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=ai_interviewer
POSTGRES_PASSWORD=            # generate one
POSTGRES_DB=ai_interviewer
POSTGRES_PORT=5432

# Consumed by the API and worker. Host is `postgres` inside Compose and
# `localhost` when running the app on the host against the Compose database.
DATABASE_URL=postgresql+psycopg://ai_interviewer:CHANGE_ME@localhost:5432/ai_interviewer

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, Tigris/R2 in deployment)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=          # generate one; min 8 chars or MinIO refuses to start
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=ai-interviewer-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=         # same value as MINIO_ROOT_PASSWORD locally
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Anthropic — not needed until Phase 3. Phases 0-2 run fully offline.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
